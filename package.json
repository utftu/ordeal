{
  "name": "ordeal",
  "version": "0.0.5",
  "description": "Запуск эвалов для сервисов на ИИ в изолированных воркерах Bun",
  "repository": {
    "type": "git",
    "url": "https://github.com/utftu/ordeal"
  },
  "license": "MIT",
  "files": [
    "dist/**"
  ],
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  },
  "exports": {
    ".": {
      "types": "./dist/ordeal.d.ts",
      "default": "./dist/ordeal.js"
    }
  },
  "bin": {
    "ordeal": "./dist/cli/cli.js"
  },
  "scripts": {
    "build:js": "bun build src/ordeal.ts src/cli/cli.ts src/pool/worker.ts --root src --outdir dist --target bun",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "bun run build:js && bun run build:types",
    "test": "bun test",
    "types": "tsc --noEmit"
  },
  "type": "module",
  "dependencies": {
    "argblock": "^0.0.15"
  }
}